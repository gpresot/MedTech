---
title: MedTech - Diagrama de Classes (Sprint 2)
---
classDiagram
    direction TB
    class Atendimento {
        <<abstract>>
        -Long id
        +getPaciente() Paciente
        +getProfissional() Profissional
        +getDataHoraPrevista() LocalDateTime
        +getSituacao() String
        +validarAtendimento() void
        #validarDadosComuns() void
    }
    class Consulta {
        <<abstract>>
        -Paciente paciente
        -Profissional profissional
        -LocalDate data
        -LocalTime horario
        -String motivo
        -String observacoesMedicas
        -StatusConsulta status
        +getTipo() TipoConsulta
        +remarcar(LocalDate, LocalTime) void
        +confirmar() void
        +iniciar() void
        +registrarNaoComparecimento() void
        +cancelar() void
        +concluir(String) void
        +validarAtendimento() void
        +verificarAgendada() void
    }
    class ConsultaRotina {
        -Especialidade especialidadeEncaminhada
        +encaminhar(Especialidade) void
        +validarAtendimento() void
    }
    class ConsultaEspecializada {
        -Especialidade especialidade
        +validarAtendimento() void
    }
    class AtendimentoEmergencia {
        -PrioridadeAtendimento prioridade
        +validarAtendimento() void
    }
    class ProcedimentoCirurgico {
        -Internacao internacao
        -Cirurgiao cirurgiao
        -String descricao
        -TipoCirurgia tipo
        -LocalDateTime dataHora
        -LocalDateTime dataHoraInicioEfetivo
        -LocalDateTime dataHoraFimEfetivo
        -StatusProcedimento status
        -String observacoesPreOperatorias
        -String observacoesPosOperatorias
        +estaAtivo() boolean
        +registrarObservacoesPreOperatorias(String) void
        +iniciar() void
        +concluir(String) void
        +cancelar() void
        +validarAtendimento() void
    }
    class Profissional {
        <<abstract>>
        -Long id
        -String nome
        -String cpf
        -String email
        -String telefone
        -String crm
    }
    class MedicoClinicoGeral {
    }
    class MedicoEspecialista {
        -Especialidade especialidade
    }
    class Cirurgiao {
    }
    class Paciente {
        -Long id
        -String nome
        -String cpf
        -LocalDate dataNascimento
        -String telefone
        -String endereco
        -String email
        +atualizarContato(String, String) void
    }
    class HistoricoMedico {
        -Long id
        -String informacoesRelevantes
        +adicionarInformacao(String) void
    }
    class Internacao {
        -Long id
        -Paciente paciente
        -Profissional profissional
        -Quarto quarto
        -LocalDate dataEntrada
        -LocalDate dataPrevistaAlta
        -LocalDate dataEfetivaAlta
        -String observacoes
        +estaAtiva() boolean
        +registrarAlta(LocalDate) void
        +alterarPrevisaoAlta(LocalDate) void
    }
    class Quarto {
        -Long id
        -int numero
        -int andar
        -TipoQuarto tipo
        -int capacidadeMaxima
        -int ocupacaoAtual
        -StatusQuarto status
        +verificarDisponibilidade() boolean
        +adicionarPaciente() void
        +removerPaciente() void
        +atualizarStatus() void
        +colocarEmManutencao() void
        +sairDeManutencao() void
        +vagasDisponiveis() int
        +atualizarDados(int, int, TipoQuarto, int) void
    }
    class Usuario {
        -Long id
        -String email
        -String senha
    }
    class TipoConsulta {
        <<enumeration>>
        ROTINA
        ESPECIALIZADA
        EMERGENCIA
    }
    class StatusConsulta {
        <<enumeration>>
        AGENDADA
        CONFIRMADA
        EM_ATENDIMENTO
        CONCLUIDA
        CANCELADA
        NAO_COMPARECEU
    }
    class StatusProcedimento {
        <<enumeration>>
        AGENDADO
        EM_ANDAMENTO
        CONCLUIDO
        CANCELADO
    }
    class TipoCirurgia {
        <<enumeration>>
        ELETIVA
        URGENCIA
        EMERGENCIA
    }
    class PrioridadeAtendimento {
        <<enumeration>>
        BAIXA
        MODERADA
        ALTA
        CRITICA
    }
    class Especialidade {
        <<enumeration>>
        CARDIOLOGIA
        NEUROLOGIA
        ORTOPEDIA
        DERMATOLOGIA
        PEDIATRIA
        OFTALMOLOGIA
        PSIQUIATRIA
        ENDOCRINOLOGIA
        GINECOLOGIA
        UROLOGIA
    }
    class TipoQuarto {
        <<enumeration>>
        ENFERMARIA
        APARTAMENTO
        UTI
    }
    class StatusQuarto {
        <<enumeration>>
        DISPONIVEL
        OCUPADO
        MANUTENCAO
    }

    Atendimento <|-- Consulta
    Atendimento <|-- ProcedimentoCirurgico
    Consulta <|-- ConsultaRotina
    Consulta <|-- ConsultaEspecializada
    Consulta <|-- AtendimentoEmergencia
    Profissional <|-- MedicoClinicoGeral
    Profissional <|-- MedicoEspecialista
    Profissional <|-- Cirurgiao
    Consulta "0..*" --> "1" Paciente : paciente
    Consulta "0..*" --> "1" Profissional : profissional
    Internacao "0..*" --> "1" Paciente : paciente
    Internacao "0..*" --> "1" Profissional : responsável
    Internacao "0..*" --> "1" Quarto : quarto
    ProcedimentoCirurgico "0..*" --> "1" Internacao : internação
    ProcedimentoCirurgico "0..*" --> "1" Cirurgiao : cirurgião
    Paciente "1" *-- "1" HistoricoMedico
